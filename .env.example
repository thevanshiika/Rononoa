# ==========================================
# SynergyHub — Environment Configuration
# ==========================================

# --- Backend Configuration ---
# Server port for Express API (default: 5000)
SERVER_PORT=5000

# Unified server port (default: 3000)
PORT=3000

# MongoDB Connection String:
# Local development default: mongodb://127.0.0.1:27017/synergyhub
# Production Atlas format: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/synergyhub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/synergyhub

# JSON Web Token Secret (replace with a 32+ character random secret in production)
JWT_SECRET=synergyhub_production_jwt_secret_key_change_in_production_2026

# JWT expiration duration
JWT_EXPIRES_IN=7d

# Allowed client origins for CORS (comma-separated if multiple, e.g. http://localhost:5173,https://synergyhub.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# --- Frontend Configuration (Vite) ---
# Client dev server port (default: 5173)
CLIENT_PORT=5173

# API base URL for Axios client
# For unified server or Vite dev proxy: /api
# For standalone client pointing to backend on port 5000: http://localhost:5000/api
# For production separate deployments: https://your-backend-domain.vercel.app/api
VITE_API_BASE_URL=/api

# Standalone Vite proxy target (default: http://localhost:5000)
VITE_BACKEND_URL=http://localhost:5000

# Node environment
NODE_ENV=development
